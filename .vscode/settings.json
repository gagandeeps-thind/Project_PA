{
  "editor.fontSize": 12,
  "editor.minimap.sectionHeaderFontSize": 5,
  "screencastMode.fontSize": 20,
  "chat.fontSize": 10,
  "claudeCode.useTerminal": true,
  "claudeCode.useCtrlEnterToSend": false,
  "deno.enablePaths": [
    "supabase/functions"
  ],
  "deno.lint": true,
  "deno.unstable": [
    "bare-node-builtins",
    "byonm",
    "sloppy-imports",
    "unsafe-proto",
    "webgpu",
    "broadcast-channel",
    "worker-options",
    "cron",
    "kv",
    "ffi",
    "fs",
    "http",
    "net"
  ],
  "[typescript]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  }
}
