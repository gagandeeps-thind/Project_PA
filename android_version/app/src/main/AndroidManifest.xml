<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Google Play Billing for global in-app purchases and subscriptions. -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- Run recording (PRD-002). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Keep recording with the screen locked: a location foreground service started while the
         app is open, so "while in use" permission is enough. No ACCESS_BACKGROUND_LOCATION. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Camera-verified exercises: pose estimation runs on the device; frames never leave it. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Step sensor and activity classification for the anti-cheat cross-check. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Start tab: live heart rate, power and speed from Bluetooth fitness sensors and watches.
         Scanning never derives location, so Android 12+ needs no location permission for it. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Start tab: import past workouts from Health Connect (read only). -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_SPEED" />
    <uses-permission android:name="android.permission.health.READ_POWER" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:name=".OsirisApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Osiris">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- osiris://challenge/<id>, osiris://invite/<token>, ... (DeepLinkParser). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="osiris" />
            </intent-filter>
            <!-- Invite and referral pages of the public site. Verified App Links need
                 https://<host>/.well-known/assetlinks.json listing this app's signing key. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${webLinkHost}" android:pathPrefix="/i/" />
                <data android:scheme="https" android:host="${webLinkHost}" android:pathPrefix="/join/" />
            </intent-filter>
        </activity>

        <!-- Health Connect shows why Osiris reads workouts: Android 13 and older ask this activity,
             Android 14+ the alias below. -->
        <activity
            android:name=".platform.health.HealthRationaleActivity"
            android:exported="true"
            android:theme="@style/Theme.Osiris">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".platform.health.HealthRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".platform.location.RunTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- ML Kit downloads nothing at runtime: the pose model ships inside the library. -->
    </application>
</manifest>
