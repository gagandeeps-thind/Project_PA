# Osiris backend — local development environment template.
# Copy to `.env` (gitignored) and fill in. main.py loads this via python-dotenv at startup.
# Real env vars set in the shell/CI/container ALWAYS win over this file (override=False).
#
# NEVER commit a real .env. Secret keys (sk_..., whsec_..., OSIRIS_JWT_SECRET) must never be
# pasted into chats, logs, or tickets — roll any that have been before going live.

# Marks an explicit dev/test environment so the fail-closed boot checks (audit §2.1) DISABLE
# the payment integrations instead of demanding real keys. Anything other than the values
# {dev,development,test,testing,local} is treated as production and requires all secrets below.
OSIRIS_ENV=dev

# --- Auth / legacy webhook (required in production) ---
# OSIRIS_JWT_SECRET=          # 32+ byte HS256 key: python -c "import secrets; print(secrets.token_urlsafe(48))"
# OSIRIS_WEBHOOK_SECRET=      # legacy generic webhook HMAC (/payments/webhook)

# --- Stripe (required in production; optional in dev — leave unset to run without payments) ---
# Get these from the Stripe Dashboard. Use TEST-mode keys until the real-money launch gate.
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx     # Developers -> Webhooks -> signing secret for
#                                     # POST /api/v1/payments/stripe/webhook
# STRIPE_PUBLISHABLE_KEY=pk_test_xxx  # public; returned to the Flutter client

# --- Optional ---
# OSIRIS_LOG_JSON=1
# OSIRIS_LOG_LEVEL=INFO
