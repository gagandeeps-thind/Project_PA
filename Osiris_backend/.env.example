# Osiris backend environment template. The full, current list lives in the repo root .env.example.
OSIRIS_ENV=dev
OSIRIS_JWT_SECRET=replace_with_a_secure_32_byte_secret_key_in_production
OSIRIS_WEBHOOK_SECRET=replace_with_a_secure_32_byte_webhook_secret_in_production
OSIRIS_TELEMETRY_TTL_DAYS=90
OSIRIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# The code reads STRIPE_SECRET_KEY (services/stripe_gateway.py); OSIRIS_STRIPE_SECRET_KEY was never read.
STRIPE_SECRET_KEY=sk_test_placeholder_key
