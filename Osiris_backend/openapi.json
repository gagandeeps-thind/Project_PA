    "/api/v1/domains/{domain_id}/vault": {
      "post": {
        "summary": "Lock Vault",
        "description": "Lock (or top up) an Ownership Fee on a domain. Crystals are deducted from the owner's\nwallet and added to the domain's Vault. Vault balance doubles as the required Challenger\nMatch amount. Topping up is allowed; unlocking (lowering) is deferred to Phase 2.",
        "operationId": "lock_vault_api_v1_domains__domain_id__vault_post",
        "parameters": [
          {
            "name": "domain_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Domain Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VaultLockRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VaultLockResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sieges/{siege_id}/resolve": {
      "post": {
        "summary": "Resolve Siege",
        "description": "Resolve a pending siege. Challenger submits their Defense Feat score.\nWIN: defender's polygon erased, pot (defender vault + challenger match) paid 80/20 to\n     challenger/system.\nLOSS: challenger's match is split 50% to defender vault / 30% to system / 20% banked as a\n      retry-discount against the same target_domain_id for this challenger.\nAny unconsumed retry discount for this challenger+domain pair is auto-applied to reduce\nthe challenger's out-of-pocket match on this attempt.",
        "operationId": "resolve_siege_api_v1_sieges__siege_id__resolve_post",
        "parameters": [
          {
            "name": "siege_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Siege Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SiegeResolveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiegeResolveResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/{user_id}/party-role": {
      "get": {
        "summary": "Get User Party Role",
        "description": "Returns the user's assigned Party Role (Vanguard / Striker / Scout / Strategist)\nbased on their leading attribute stat. MVP uses lifetime totals; Phase 2 will switch\nto a rolling 30-day window computed from an ActivityLog.",
        "operationId": "get_user_party_role_api_v1_users__user_id__party_role_get",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "User Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
