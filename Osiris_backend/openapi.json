            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/merchants/register": {
      "post": {
        "summary": "Register Merchant",
        "description": "Registers a B2B partner who can sponsor merchant_chest bounties at their storefront.\nFor MVP this is unauthenticated; production will gate it behind a Merchant Portal admin login.",
        "operationId": "register_merchant_api_v1_merchants_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MerchantCreate"
              }
            }
          },
          "required": true
        },
