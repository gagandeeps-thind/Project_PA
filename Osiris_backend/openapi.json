    "/api/v1/domains": {
      "post": {
        "summary": "Submit Domain",
        "description": "Processes a completed Domain Trace, validates anti-cheat, and claims the territory.",
        "operationId": "submit_domain_api_v1_domains_post",
        "requestBody": {
          "content": {
            "application/json": {
