# Copy to .env (git-ignored) for local runs and docker compose. Never commit real values.
# Deployed environments inject secrets from the secret manager instead: every secret below
# also accepts NAME_FILE=/path/to/file (Docker/Kubernetes secrets, Vault Agent, ECS secrets).

# --- Backend (Osiris_backend/settings.py) ---
# dev | test | production. Unset or unknown is treated as production and refuses to boot without secrets.
OSIRIS_ENV=dev
# 32+ random bytes: python -c "import secrets; print(secrets.token_urlsafe(48))". Outside dev/test a missing
# or shorter secret refuses to boot.
OSIRIS_JWT_SECRET=
# Hex HMAC key for /payments/webhook. Required outside dev/test.
OSIRIS_WEBHOOK_SECRET=
# Bearer token for /metrics. Without it /metrics is served only in dev/test.
OSIRIS_METRICS_TOKEN=
# SQLAlchemy URL. Default: SQLite file Osiris_backend/fitness_mvp.db. Production is Supabase PostgreSQL via the
# session pooler: postgresql://postgres.<ref>:<password>@aws-?-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# (postgres:// and postgresql:// are pinned to psycopg 3). Keep OSIRIS_DB_POOL_SIZE + OSIRIS_DB_MAX_OVERFLOW
# under the pooler's connection limit, e.g. 5 + 5.
OSIRIS_DATABASE_URL=
# Connection pool per API process (ignored for SQLite). Size + overflow is the most connections one
# instance opens; times the instance count it must stay under the pooler's limit. Pre-ping is always on.
OSIRIS_DB_POOL_SIZE=20
OSIRIS_DB_MAX_OVERFLOW=20
# Seconds to wait for a free connection before the request fails.
OSIRIS_DB_POOL_TIMEOUT=10
# Seconds before a pooled connection is replaced; keep under the pooler's / proxy's idle timeout.
OSIRIS_DB_POOL_RECYCLE=1800
# 0: this process serves requests without the background jobs (decay, settlement, TTL). Exactly one
# process in the deployment must run them.
OSIRIS_RUN_SCHEDULER=1
# Seconds other players' values on the global leaderboards may lag (the viewer's own is always fresh).
# 0 turns the cache off. Default 60; off under OSIRIS_ENV=test.
OSIRIS_LEADERBOARD_CACHE_SECONDS=60
# Comma-separated admin web origins. Outside dev/test there is no default: unset allows no browser origin.
OSIRIS_CORS_ORIGINS=http://localhost:5173
OSIRIS_PUBLIC_BASE_URL=http://localhost:8000
# Behind a CDN: the value the CDN sends as X-Origin-Verify. Set, every other request gets 403
# (except /healthz), WebSocket upgrades included, and the rate limiter keys on CF-Connecting-IP. Leave empty
# without a CDN. OSIRIS_ENV=production refuses to boot without it unless OSIRIS_ALLOW_NO_CDN=1.
OSIRIS_ORIGIN_SECRET=
# 1: production runs without a CDN on purpose (then every player shares the proxy's rate-limit bucket).
OSIRIS_ALLOW_NO_CDN=
# Shared rate-limit counts across API instances (Upstash REST URL and token). Empty: per process.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
OSIRIS_LOG_LEVEL=INFO
OSIRIS_LOG_JSON=0
OSIRIS_TELEMETRY_TTL_DAYS=90
OSIRIS_ROUTE_POINT_TTL_DAYS=45

# --- Google Play Billing verification (services/google_play.py) ---
# Service-account key JSON (or GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_FILE=<path>); unset -> verify answers 503.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=osiris.fit
# Shared token for the Real-time Developer Notifications endpoint (Pub/Sub push URL ...?token=<value>).
# Unset -> POST /api/v2/payments/google-play/rtdn answers 503.
GOOGLE_PLAY_RTDN_TOKEN=
# true: Play licence-test purchases are granted (internal testing). false: they answer 403 (public launch).
GOOGLE_PLAY_ALLOW_TEST_PURCHASES=true
# --- App Store (StoreKit 2) verification (services/app_store.py, docs/architecture/app-store-billing.md) ---
# Which StoreKit environments are granted: Production, Sandbox, or "Production,Sandbox".
# Unset -> POST /api/v2/payments/app-store/verify and /notifications answer 503 and nothing is granted.
# Sandbox covers TestFlight and App Review purchases, which are free: they mint real crystals while it is on.
APPLE_APP_STORE_ENVIRONMENT=
APPLE_BUNDLE_ID=osiris.fit
# Not read yet: App Store Server API key (App Store Connect > Users and Access > Integrations > In-App Purchase),
# for future calls to Apple. APPLE_PRIVATE_KEY is the .p8 content (or APPLE_PRIVATE_KEY_FILE=<path>).
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# App signing SHA-256 from Play Console > Setup > App signing (comma-separated); fills /.well-known/assetlinks.json.
OSIRIS_ANDROID_CERT_SHA256=

# --- Nightly database backup to Cloudflare R2 (infrastructure/backup, Render cron job) ---
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Encrypts every dump; without it no backup can be restored. Keep a copy in a password manager.
BACKUP_PASSPHRASE=

# --- Admin web (Vite, build time) ---
VITE_API_BASE_URL=http://localhost:8000
