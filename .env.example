# Copy to .env (git-ignored) for local runs and docker compose. Never commit real values.
# Deployed environments inject secrets from the secret manager instead: every secret below
# also accepts NAME_FILE=/path/to/file (Docker/Kubernetes secrets, Vault Agent, ECS secrets).

# --- Backend (Osiris_backend/settings.py) ---
# dev | test | production. Unset or unknown is treated as production and refuses to boot without secrets.
OSIRIS_ENV=dev
# 32+ random bytes: python -c "import secrets; print(secrets.token_urlsafe(48))"
OSIRIS_JWT_SECRET=
# Hex HMAC key for /payments/webhook. Required outside dev/test.
OSIRIS_WEBHOOK_SECRET=
# Bearer token for /metrics. Without it /metrics is served only in dev/test.
OSIRIS_METRICS_TOKEN=
# SQLAlchemy URL. Default: SQLite file Osiris_backend/fitness_mvp.db. Production is Supabase PostgreSQL via the
# session pooler: postgresql://postgres.<ref>:<password>@aws-?-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# (postgres:// and postgresql:// are pinned to psycopg 3). Keep OSIRIS_DB_POOL_SIZE + OSIRIS_DB_MAX_OVERFLOW
# under the pooler's connection limit, e.g. 5 + 5.
OSIRIS_DATABASE_URL=
# Comma-separated admin web origins.
OSIRIS_CORS_ORIGINS=http://localhost:5173
OSIRIS_PUBLIC_BASE_URL=http://localhost:8000
# Behind a CDN: the value the CDN sends as X-Origin-Verify. Set, every other request gets 403
# (except /healthz) and the rate limiter keys on CF-Connecting-IP. Leave empty without a CDN.
OSIRIS_ORIGIN_SECRET=
# Shared rate-limit counts across API instances (Upstash REST URL and token). Empty: per process.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
OSIRIS_LOG_LEVEL=INFO
OSIRIS_LOG_JSON=0
OSIRIS_TELEMETRY_TTL_DAYS=90
OSIRIS_ROUTE_POINT_TTL_DAYS=45

# --- Stripe (test-mode keys only outside production) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Nightly database backup to Cloudflare R2 (infrastructure/backup, Render cron job) ---
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Encrypts every dump; without it no backup can be restored. Keep a copy in a password manager.
BACKUP_PASSPHRASE=

# --- Admin web (Vite, build time) ---
VITE_API_BASE_URL=http://localhost:8000
