          "domain_id",
          "vault_balance",
          "crystals_spent",
          "mana_crystals_remaining",
          "message"
        ],
        "title": "VaultLockResponse",
        "type": "object"
      },
      "VerificationResult": {
        "properties": {
          "activity_type": {
            "title": "Activity Type",
            "type": "string"
          },
          "confidence": {
            "title": "Confidence",
            "type": "number"
          },
          "flags": {
            "items": {
              "type": "string"
            },
            "title": "Flags",
            "type": "array"
          },
          "verified": {
            "title": "Verified",
            "type": "boolean"
          },
          "verified_score": {
            "title": "Verified Score",
            "type": "integer"
          }
        },
        "required": [
          "verified",
          "confidence",
          "verified_score",
          "activity_type",
          "flags"
        ],
        "title": "VerificationResult",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Verified Fitness Reward System API",
    "version": "1.0-MVP"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "root__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Root"
      }
    },
    "/api/v1/activities/verify": {
      "post": {
        "description": "Stateless preview of the ML Referee. The frontend can call this to confirm a workout\nwill pass before submitting the real action (claim, siege, bounty). No DB writes.",
        "operationId": "verify_activity_endpoint_api_v1_activities_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivityProof"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Verify Activity Endpoint"
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "Role-aware login. Probes Admin \u2192 Merchant \u2192 User in that order; the first table that\ncontains the email **and** matches the password wins. Returns `{role, id, email, name}`\nso the Flutter app can route into admin / merchant / game UI accordingly.\n\nProbe order matters: admins are most privileged, so they're checked first to ensure\nthat if Gagan accidentally creates a player account with the same email as the admin\naccount (very unlikely), admin still wins.",
        "operationId": "auth_login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthLoginResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Auth Login"
      }
    },
    "/api/v1/bounties": {
      "post": {
        "description": "Seed a bounty. Used by admins for daily quests and by merchants for storefront chests.\nGeofence radius is in metres; distance to caller is filled with 0 since the creator may not\nbe on-site.",
        "operationId": "create_bounty_api_v1_bounties_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BountyCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BountySummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Bounty"
      }
    },
    "/api/v1/bounties/nearby": {
      "get": {
        "description": "Returns active, non-expired, non-full bounties within `radius_km` of (lat, lng), sorted\nnearest-first. MVP uses an in-memory haversine sweep; PostGIS will replace this with\n`ST_DWithin` in Phase 2.",
        "operationId": "get_nearby_bounties_api_v1_bounties_nearby_get",
        "parameters": [
          {
            "in": "query",
            "name": "lat",
            "required": true,
            "schema": {
              "title": "Lat",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "lng",
            "required": true,
            "schema": {
              "title": "Lng",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "radius_km",
            "required": false,
            "schema": {
              "default": 5.0,
              "title": "Radius Km",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/BountySummary"
                  },
                  "title": "Response Get Nearby Bounties Api V1 Bounties Nearby Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Nearby Bounties"
      }
    },
    "/api/v1/bounties/{bounty_id}/complete": {
      "post": {
        "description": "Validates proximity + score, awards XP/crystals, increments the matching attribute stat,\nand (for merchant chests) issues a single-use coupon code. One claim per user per bounty.",
        "operationId": "complete_bounty_api_v1_bounties__bounty_id__complete_post",
        "parameters": [
          {
            "in": "path",
            "name": "bounty_id",
            "required": true,
            "schema": {
              "title": "Bounty Id",
              "type": "integer"
