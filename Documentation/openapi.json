              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VaultLockResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Lock Vault"
      }
    },
    "/api/v1/login": {
      "post": {
        "description": "Player-only login. Kept for backward compatibility; new clients should use the\nrole-aware `/api/v1/auth/login` endpoint and switch UI based on the returned `role`.",
