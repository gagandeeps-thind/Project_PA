          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Complete Bounty"
      }
    },
    "/api/v1/domains": {
      "post": {
        "description": "Processes a completed Domain Trace, validates anti-cheat, and claims the territory.",
