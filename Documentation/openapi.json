    "/api/v1/users/{user_id}/party-role": {
      "get": {
        "description": "Returns the user's Party Role. Two modes:\n   - default (no `window_days`)  \u2192 lifetime totals on `User.{str/agi/end/con}_stat`\n   - `?window_days=N`            \u2192 rolling sum of `ActivityLog.score` per stat over the\n                                   last N days, computed from `occurred_at`.\n\nPhase 1 wrote stats only as lifetime totals; v2.7 adds the ActivityLog-backed rolling\npath so the 30-day Party Role can flip even if a user's career totals stay unchanged.",
        "operationId": "get_user_party_role_api_v1_users__user_id__party_role_get",
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "title": "User Id",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "window_days",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Window Days"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartyRoleResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get User Party Role"
      }
    }
  }
