    "/api/v1/platform/revenue": {
      "get": {
        "description": "Aggregates the PlatformRevenue ledger so admins can audit total platform earnings and\nthe breakdown by source. Read-only; safe to expose internally during MVP. Production will\ngate this behind an admin role.",
        "operationId": "get_platform_revenue_api_v1_platform_revenue_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformRevenueSummary"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Platform Revenue"
      }
    },
    "/api/v1/sieges/{siege_id}/resolve": {
      "post": {
        "description": "Resolve a pending siege. Challenger submits their Defense Feat score.\nWIN: defender's polygon erased, pot (defender vault + challenger match) paid 80/20 to\n     challenger/system.\nLOSS: challenger's match is split 50% to defender vault / 30% to system / 20% banked as a\n      retry-discount against the same target_domain_id for this challenger.\nAny unconsumed retry discount for this challenger+domain pair is auto-applied to reduce\nthe challenger's out-of-pocket match on this attempt.",
        "operationId": "resolve_siege_api_v1_sieges__siege_id__resolve_post",
        "parameters": [
          {
            "in": "path",
            "name": "siege_id",
            "required": true,
            "schema": {
              "title": "Siege Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SiegeResolveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiegeResolveResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Resolve Siege"
      }
    },
    "/api/v1/users/{user_id}": {
      "get": {
        "description": "Fetches the latest stats, Rank, and XP for the app dashboard.",
