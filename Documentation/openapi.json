    },
    "/api/v1/domains/{domain_id}/vault": {
      "post": {
        "description": "Lock (or top up) an Ownership Fee on a domain. Crystals are deducted from the owner's\nwallet and added to the domain's Vault. Vault balance doubles as the required Challenger\nMatch amount. Topping up is allowed; unlocking (lowering) is deferred to Phase 2.",
        "operationId": "lock_vault_api_v1_domains__domain_id__vault_post",
        "parameters": [
          {
            "in": "path",
            "name": "domain_id",
            "required": true,
            "schema": {
              "title": "Domain Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VaultLockRequest"
