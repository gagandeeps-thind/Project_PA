# Android Release Signing Configuration Template
# ---------------------------------------------------------------------------
# Copy this file to `keystore.properties` (or `key.properties`) in the project
# root and fill in your upload keystore credentials.
#
# Both `keystore.properties` and `*.jks`/`*.keystore` files are git-ignored
# and enforced by `.claude/hooks/gate.sh` so credentials are never committed.
#
# Alternatively, supply these values via environment variables in CI/CD:
#   OSIRIS_KEYSTORE_FILE      (or ANDROID_KEYSTORE_FILE)
#   OSIRIS_KEYSTORE_PASSWORD  (or ANDROID_KEYSTORE_PASSWORD)
#   OSIRIS_KEY_ALIAS          (or ANDROID_KEY_ALIAS)
#   OSIRIS_KEY_PASSWORD       (or ANDROID_KEY_PASSWORD)
# ---------------------------------------------------------------------------

storeFile=android_version/release-upload-keystore.jks
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=osiris-upload
keyPassword=CHANGE_ME_KEY_PASSWORD

